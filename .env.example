# Postgres connection (Railway injects DATABASE_URL automatically)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/netkoc?schema=public"

# 32+ characters secret for JWT session signing
AUTH_SECRET="change-me-to-a-long-random-string-of-32-chars-or-more"

# Base URL (used for invite links, PDF absolute URLs)
APP_URL="http://localhost:3000"

# Initial platform admin (seed oluştururken kullanılır)
ADMIN_EMAIL="admin@netkoc.app"
ADMIN_PASSWORD="Admin123!"
